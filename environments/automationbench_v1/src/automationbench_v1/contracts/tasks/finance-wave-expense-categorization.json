{
  "schema_version": 1,
  "manifest_id": "finance-wave-expense-categorization",
  "revision": "luna_finance_batch02_r1",
  "public_request": "Categorize the uncategorized bank transactions. Match each transaction to the correct expense category based on the vendor mapping rules. Update the tracker and email the categorization summary to bookkeeper@company.example.com. ",
  "bindings": [
    {
      "path": [
        "task_evidence",
        "prompt",
        1,
        "content"
      ],
      "canonical_sha256": "1bb540630eaf0f18a41c358a469779fcab1bdbaa16296b9371a56f2d2d19b647"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "google_sheets",
        "rows"
      ],
      "canonical_sha256": "118c8aa793c648a976c9a8dfe604567c30a3e70124e5508d40808666c0a5b4f7"
    }
  ],
  "sources": {
    "transactions": {
      "adapter": "google_sheets.rows@1",
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "spreadsheet_id": "ss_bank_cat",
      "worksheet_id": "ws_uncategorized",
      "key_fields": [
        "Date"
      ],
      "required_fields": [
        "Description",
        "Amount",
        "Category",
        "Status"
      ]
    },
    "mapping": {
      "adapter": "google_sheets.rows@1",
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "spreadsheet_id": "ss_bank_cat",
      "worksheet_id": "ws_vendor_map",
      "key_fields": [
        "Vendor Pattern"
      ],
      "required_fields": [
        "Category"
      ]
    },
    "updates": {
      "adapter": "google_sheets.row_writes@1",
      "kind": "update",
      "spreadsheet_id": "ss_bank_cat",
      "worksheet_id": "ws_uncategorized"
    },
    "sends": {
      "adapter": "gmail.messages@1",
      "kind": "send"
    },
    "bookkeeper": {
      "adapter": "public.request@1",
      "member_key": "bookkeeper-categorization-summary",
      "fields": {
        "recipient": {
          "value": "bookkeeper@company.example.com",
          "authority_paths": [
            [
              "task_evidence",
              "prompt",
              1,
              "content"
            ]
          ]
        }
      }
    }
  },
