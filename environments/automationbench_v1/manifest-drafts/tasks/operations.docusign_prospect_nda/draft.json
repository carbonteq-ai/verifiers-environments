    {
      "path": [
        "task_evidence",
        "prompt",
        1,
        "content"
      ],
      "canonical_sha256": "0b8ae66398f12e30c146cc5ad18711c14f18853a7cf28bf05d58f24dbc2b1c39"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
