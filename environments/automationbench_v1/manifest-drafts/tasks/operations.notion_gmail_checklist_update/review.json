  "obligations": [
    {
      "id": "C1",
      "kind": "selection",
      "status": "expressed",
      "check_id": "selected-vendor-onboarding-email-read",
      "public_anchor": {
        "text": "Ops leads sent over updates for the vendor onboarding checklist - can you get that into Notion and confirm with them?\n\nCheck the emails from ops-leads@company.example.com about the vendor onboarding checklist and find the latest update. Make sure it's specifically about vendor onboarding, not other checklists.\n\nCreate a Notion page under pg_ops with the update, and reply to confirm it's done.\n\nIf the update adds any security-related steps (like badge request, access control, or security clearance), also post to #security-team so they're aware. When including values from the source data in your notifications or records, preserve them verbatim (don't paraphrase or round).",
        "path": "prompt[1].content; initial_state.gmail.messages"
      },
      "note": "Select latest vendor onboarding update from ops leads, excluding unrelated checklists and draft/pending messages."
    },
    {
      "id": "C2",
      "kind": "goal",
      "status": "expressed",
      "check_id": "approved-vendor-onboarding-update-published",
      "public_anchor": {
        "text": "Ops leads sent over updates for the vendor onboarding checklist - can you get that into Notion and confirm with them?\n\nCheck the emails from ops-leads@company.example.com about the vendor onboarding checklist and find the latest update. Make sure it's specifically about vendor onboarding, not other checklists.\n\nCreate a Notion page under pg_ops with the update, and reply to confirm it's done.\n\nIf the update adds any security-related steps (like badge request, access control, or security clearance), also post to #security-team so they're aware. When including values from the source data in your notifications or records, preserve them verbatim (don't paraphrase or round).",
        "path": "prompt[1].content"
      },
      "note": "Create Notion page under pg_ops with update."
    },
    {
      "id": "C3",
      "kind": "goal",
      "status": "expressed",
      "check_id": "ops-leads-confirmed",
      "public_anchor": {
        "text": "Ops leads sent over updates for the vendor onboarding checklist - can you get that into Notion and confirm with them?\n\nCheck the emails from ops-leads@company.example.com about the vendor onboarding checklist and find the latest update. Make sure it's specifically about vendor onboarding, not other checklists.\n\nCreate a Notion page under pg_ops with the update, and reply to confirm it's done.\n\nIf the update adds any security-related steps (like badge request, access control, or security clearance), also post to #security-team so they're aware. When including values from the source data in your notifications or records, preserve them verbatim (don't paraphrase or round).",
        "path": "prompt[1].content"
      },
      "note": "Reply to confirm completion."
    },
    {
      "id": "C4",
