      "id": "D-r6-2",
      "name": "record_writes_requires_id_field",
      "reproducer": "load_contract with {\"adapter\": \"service.record_writes@1\", \"service\": \"xero\", \"collection\": [\"contacts\"], \"kind\": \"create\"} -> record_writes_collection_identity_unavailable",
      "what": "service.record_writes@1 (and final.records@1) require an `id` field on the collection model; every Xero collection is keyed by `<kind>_id` (contacts.contact_id, payments.payment_id, ...), so no Xero create/update/delete is observable. identity_paths cannot help: collection_shape rejects the collection before identity_paths are read, and identity_paths need 2-4 fields.",
      "code": "src/automationbench_v1/contracts/record_writes.py collection_shape / RecordWriteSource.installed_collection",
      "fix_sketch": "Allow a reviewed single-field identity (identity_paths of length 1, e.g. [[\"contact_id\"]]) for list collections without `id`, mirroring initial.records@1 which already accepts it.",
      "reused_by": [
        "finance.xero_vendor_onboard",
        "finance.sales_tax_remittance (Xero payment channel of the payment guard)",
        "any Xero task"
      ]
    }
