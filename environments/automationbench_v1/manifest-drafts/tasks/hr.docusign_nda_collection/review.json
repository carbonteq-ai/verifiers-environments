  {
   "id": "R6-HRA-D6",
   "summary": "Field paths into a list index that does not exist (effect.record.signers[1].email on a one-signer envelope) are unknown, which made every envelope match unknown for other candidates and broke unique_candidate. Workaround: wrap the optional index in proven().",
   "smallest_fix": "an 'in' over a projected list field (any element's email) would avoid index guessing."
  },
  {
   "id": "R6-HRA-D1",
   "summary": "google_sheets.row_writes@1 stays incomplete (sheet_requested_spreadsheet_ambiguous) after a failed google_sheets_update_row({}) that changed nothing; every sheet guard abstains on the Luna NDA episode (the installed preserve-signed guard included).",
   "smallest_fix": "close sheet scope over acknowledged failed calls whose BEFORE/AFTER sheet state is identical, as record_writes does for footprint-excluded calls."
  }
 ],
