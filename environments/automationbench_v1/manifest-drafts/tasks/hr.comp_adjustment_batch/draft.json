    {
      "path": [
        "task_evidence",
        "prompt"
      ],
      "canonical_sha256": "a5d411a28fe769d5178411f456e6a0c992f25164ce55b8e6b85429475c272c2f"
    },
    {
      "path": [
        "task_evidence",
        "initial"
      ],
      "canonical_sha256": "0b50a9d47ea32b0a4ecec69c8829b364acadabf15114cb2d11cba0a78cccab43"
    }
  ],
