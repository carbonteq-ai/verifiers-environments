      "worksheet_id": "ws_adjustments_5132",
      "key_fields": [
        "Email"
      ],
      "required_fields": [
        "Current Salary",
        "Email",
        "Employee",
        "Manager Email",
        "New Salary",
        "Notes",
        "Raise Amount",
        "Status"
