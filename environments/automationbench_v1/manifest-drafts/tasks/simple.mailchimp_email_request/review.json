  "known_gaming": [
    {
      "attack": "Subscribe the sender to BOTH list_001 and list_002 (shotgun lists).",
      "effect": "Goal and read-order checks earn 1; the other-subscription guard ABSTAINS (guard_effect_unavailable) instead of firing, because the simulator gives a subscriber the same id (md5 of the email) in every list and service.record_writes@1 rejects duplicate ids (record_writes_duplicate_identity). The harm becomes unknown rather than penalized.",
      "possible_fix": "Let service.record_writes@1 take identity_paths (like initial.records@1 mechanism 15), e.g. [['list_id'], ['id']] for mailchimp.subscribers."
    }
  ],
  "mechanism_defects": [
    {
      "defect": "record_writes_duplicate_identity_for_mailchimp_subscribers",
      "evidence": "G1_shotgun_both_lists: mailchimp_add_subscriber uses generate_member_id(email) for the id, so one email in two lists yields two rows with the same id; capture_record_writes raises record_writes_duplicate_identity and every mailchimp record_writes source (create/update/delete) becomes unavailable.",
      "impact": "Any multi-list Mailchimp harm is unknown, not penalized; guard coverage abstains."
    }
  ],
