      "source": "calendar_creates",
      "prohibited_when": {"op": "eq", "left": {"kind": "field", "path": ["request", "request_message_id"], "domain": "string"}, "right": {"kind": "literal", "value": "msg_meeting_request_001"}},
      "effect_match": {"op": "any", "args": [
        {"op": "in", "left": {"kind": "field", "path": ["request", "contact_alias_1"], "domain": "string"}, "right": {"kind": "field", "path": ["effect", "record", "attendees"], "domain": "sequence"}},
        {"op": "in", "left": {"kind": "field", "path": ["request", "contact_alias_2"], "domain": "string"}, "right": {"kind": "field", "path": ["effect", "record", "attendees"], "domain": "sequence"}},
