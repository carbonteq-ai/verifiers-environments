      "population": "request",
      "source": "calendar_creates",
      "prohibited_when": {"op": "eq", "left": {"kind": "field", "path": ["request", "request_message_id"], "domain": "string"}, "right": {"kind": "literal", "value": "msg_meeting_request_001"}},
      "effect_match": {"op": "all", "args": [
        {"op": "eq", "left": {"kind": "field", "path": ["join", "prior_matching_meeting"], "domain": "string"}, "right": {"kind": "literal", "value": "matched"}},
