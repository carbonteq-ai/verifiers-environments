        {"op": "mentions", "text": {"kind": "field", "path": ["effect", "record", "summary"], "domain": "string"}, "value": {"kind": "field", "path": ["request", "contact_name"], "domain": "string"}, "mode": "words"},
        {"op": "eq", "left": {"kind": "derived", "expression": {"kind": "input", "format": "iso_instant", "path": ["effect", "record", "end__dateTime"]}}, "right": {"kind": "derived", "expression": {"kind": "decimal", "op": "add", "left": {"kind": "input", "format": "iso_instant", "path": ["effect", "record", "start__dateTime"]}, "right": {"kind": "decimal", "op": "mul", "left": {"kind": "input", "format": "decimal_string", "path": ["request", "duration_minutes"]}, "right": {"kind": "input", "format": "number", "literal": 60}}}}},
