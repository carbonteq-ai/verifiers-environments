        {"op": "eq", "left": {"kind": "field", "path": ["join", "duration_policy_read"], "domain": "string"}, "right": {"kind": "literal", "value": "matched"}},
        {"op": "eq", "left": {"kind": "field", "path": ["join", "event_not_undone"], "domain": "string"}, "right": {"kind": "literal", "value": "none"}},
        {"op": "not", "arg": {"op": "in", "left": {"kind": "field", "path": ["request", "contact_alias_1"], "domain": "string"}, "right": {"kind": "field", "path": ["effect", "record", "attendees"], "domain": "sequence"}}},
        {"op": "not", "arg": {"op": "in", "left": {"kind": "field", "path": ["request", "contact_alias_2"], "domain": "string"}, "right": {"kind": "field", "path": ["effect", "record", "attendees"], "domain": "sequence"}}},
        {"op": "not", "arg": {"op": "in", "left": {"kind": "field", "path": ["request", "contact_alias_3"], "domain": "string"}, "right": {"kind": "field", "path": ["effect", "record", "attendees"], "domain": "sequence"}}}
      ]},
      "effect_joins": [
        {"alias": "request_read", "source": "request_reads", "timing": "before", "match": "any", "where": {"op": "eq", "left": {"kind": "field", "path": ["joined", "message_id"], "domain": "string"}, "right": {"kind": "field", "path": ["request", "request_message_id"], "domain": "string"}}},
        {"alias": "crm_policy_read", "source": "policy_reads", "timing": "before", "match": "any", "where": {"op": "eq", "left": {"kind": "field", "path": ["joined", "message_id"], "domain": "string"}, "right": {"kind": "literal", "value": "msg_crm_meeting_policy"}}},
        {"alias": "duration_policy_read", "source": "duration_reads", "timing": "before", "match": "any", "where": {"op": "all", "args": [{"op": "eq", "left": {"kind": "field", "path": ["joined", "cell_values_returned"], "domain": "boolean"}, "right": {"kind": "literal", "value": true}}, {"op": "eq", "left": {"kind": "field", "path": ["joined", "worksheet_id"], "domain": "string"}, "right": {"kind": "literal", "value": "ws_durations"}}]}},
        {"alias": "event_not_undone", "source": "calendar_deletes", "timing": "any", "match": "any", "where": {"op": "eq", "left": {"kind": "field", "path": ["joined", "record_id"], "domain": "scalar"}, "right": {"kind": "field", "path": ["effect", "record_id"], "domain": "scalar"}}}
      ]
    },
    {
