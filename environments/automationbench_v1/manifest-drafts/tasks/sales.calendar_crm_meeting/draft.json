        {"op": "eq", "left": {"kind": "field", "path": ["effect", "record", "start__dateTime"], "domain": "string"}, "right": {"kind": "field", "path": ["joined", "record", "start__dateTime"], "domain": "string"}},
        {"op": "eq", "left": {"kind": "field", "path": ["effect", "record", "end__dateTime"], "domain": "string"}, "right": {"kind": "field", "path": ["joined", "record", "end__dateTime"], "domain": "string"}},
        {"op": "in", "left": {"kind": "field", "path": ["request", "contact_email"], "domain": "string"}, "right": {"kind": "field", "path": ["effect", "record", "attendees"], "domain": "sequence"}},
        {"op": "in", "left": {"kind": "field", "path": ["request", "contact_email"], "domain": "string"}, "right": {"kind": "field", "path": ["joined", "record", "attendees"], "domain": "sequence"}}
      ]}},
        {"alias": "prior_matching_meeting_delete", "source": "calendar_deletes", "timing": "before", "match": "any", "where": {"op": "all", "args": [
          {"op": "eq", "left": {"kind": "field", "path": ["effect", "record", "start__dateTime"], "domain": "string"}, "right": {"kind": "field", "path": ["joined", "before", "start__dateTime"], "domain": "string"}},
          {"op": "eq", "left": {"kind": "field", "path": ["effect", "record", "end__dateTime"], "domain": "string"}, "right": {"kind": "field", "path": ["joined", "before", "end__dateTime"], "domain": "string"}},
          {"op": "in", "left": {"kind": "field", "path": ["request", "contact_email"], "domain": "string"}, "right": {"kind": "field", "path": ["joined", "before", "attendees"], "domain": "sequence"}}
