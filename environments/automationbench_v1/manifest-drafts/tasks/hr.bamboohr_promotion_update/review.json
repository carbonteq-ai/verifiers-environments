  "mechanism_defects": [
    {
      "id": "R6-HRB-D1",
      "kind": "mechanism",
      "summary": "slack.messages@1 scope needs a `users` collection in the public initial Slack state. These tasks declare only channels and messages. contracts/slack_effects.py::_scope raises slack_collection_unavailable:users, so the Slack inventory is never complete. Every Slack-based known zero and every guard-compliance result that has a Slack alternative stays unknown, even though matches still score 1.",
      "evidence": "Simulator: a Gmail-only run scores a Slack-alternative obligation as abstained (obligation_effect_scope_unavailable). Seeding \"users\": [] in the harness gives the correct 0.",
      "fix_sketch": "Treat a collection missing from sparse public Slack as empty (as public_service_matches already does for other sparse services), or hydrate it through WorldState before _scope.",
      "affected": "celebrations-post zeros and pending-guard compliance"
    }
  ],
