{
  "schema_version": 1,
  "manifest_id": "operations-contractor_onboarding_workflow",
  "revision": "batch04_public_components_v1",
  "public_request": "Process the new contractor onboarding queue. Check the contractor management spreadsheet for entries with Status 'Pending Onboarding'.\\n\\nFor each pending contractor, create an Asana onboarding task in the onboarding project under the 'New Contractors' section with their name and start date.\\n\\nSend each pending contractor a welcome email to their personal email with their start date and reporting manager's name from the sheet.\\n\\nThe contractors spreadsheet has additional worksheets with onboarding policies — review those before processing.\n\nDon't create tasks or send emails for contractors who are already marked 'Onboarding Complete' or 'Active'.\n\nToday is 2026-02-09. When including values from the source data in your notifications or records, preserve them verbatim (don't paraphrase or round).",
  "bindings": [
    {
      "path": [
        "task_evidence",
        "prompt",
        1,
        "content"
      ],
      "canonical_sha256": "88583287b52529d38573e92e22ca506173f46c2be6083ac49f986db260cbe35c"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "canonical_sha256": "416848cfb2457c1f30a08a45be5190b20a647f5a546f82c53dee4e31b3296e47"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "gmail"
      ],
      "canonical_sha256": "ecbcc27ce7cd4a7c680ad18f2b4fe3976a2b48a7765ba6688b1143f0de0cdb08"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "asana"
      ],
      "canonical_sha256": "e0275bc4a4b3d7a7a25a147d0d9104f74e6ffe5f244e27309746c662532ad0c8"
    }
  ],
  "sources": {
    "contractors": {
      "adapter": "google_sheets.rows@1",
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "spreadsheet_id": "ss_contractors",
      "worksheet_id": "ws_pending",
      "key_fields": [
        "Department",
        "Name"
      ],
      "required_fields": [
        "Personal Email",
        "Start Date",
        "Status",
        "Reporting Manager"
      ]
    },
    "policies": {
      "adapter": "google_sheets.reads@1",
      "spreadsheet_id": "ss_contractors",
      "worksheet_id": "ws_onboarding_policy"
    },
    "asana_create": {
      "adapter": "service.record_writes@1",
      "service": "asana",
      "collection": [
        "actions",
        "create_task"
      ],
      "kind": "create"
    },
    "asana_section": {
      "adapter": "service.record_writes@1",
      "service": "asana",
      "collection": [
        "actions",
        "add_task_to_section"
      ],
      "kind": "create"
    },
    "sends": {
      "adapter": "gmail.messages@1",
      "kind": "send"
    }
  },
