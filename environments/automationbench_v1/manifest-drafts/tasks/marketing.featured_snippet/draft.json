{
  "schema_version": 1,
  "manifest_id": "marketing-featured_snippet-batch05-public-components",
  "revision": "batch05_public_components_r1",
  "public_request": "Find featured snippet opportunities from SERP analysis (spreadsheet ID: ss_serp, worksheet ID: ws_data). Prioritize by value and add to the optimization queue.\n\nFYI, 'crm pricing' is a high-intent commercial keyword we want to target. The 'crm benefits' page is being sunset.",
  "bindings": [
    {
      "path": [
        "task_evidence",
        "prompt"
      ],
      "canonical_sha256": "4e070a8942a178c9ee6155f1110e597132b68c47cc51c36deb6e6d61aed790b6"
    },
    {
      "path": [
        "task_evidence",
        "initial"
      ],
      "canonical_sha256": "0478e39ee5daf9222d21cbbc3d7c704effb9d485cfa93698376ddf4852137deb"
    }
  ],
  "sources": {
    "rows_ws_data": {
      "adapter": "google_sheets.rows@1",
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "spreadsheet_id": "ss_serp",
      "worksheet_id": "ws_data",
      "key_fields": [
        "keyword"
      ],
      "required_fields": [
        "has_featured_snippet",
        "keyword",
        "notes",
        "our_position",
        "snippet_owner",
        "volume"
      ]
    },
    "updates_rows_ws_data": {
      "adapter": "google_sheets.row_writes@1",
      "kind": "update",
      "spreadsheet_id": "ss_serp",
      "worksheet_id": "ws_data"
    },
    "queue_adds": {
      "adapter": "google_sheets.row_writes@1",
      "kind": "append",
      "spreadsheet_id": "ss_optimize",
      "worksheet_id": "ws_queue"
    }
  },
  "checks": [
    {
      "check_id": "high-intent-opportunity-queued",
      "signal_id": "marketing.high_intent_opportunity_queued",
      "role": "goal",
      "operator": "effects.required_when@1",
      "semantics": "new_occurrence",
      "match_cardinality": "per_candidate",
      "population": "rows_ws_data",
      "source": "queue_adds",
      "required_when": {
        "op": "eq",
        "left": {
          "kind": "field",
          "path": [
            "request",
            "keyword"
          ],
          "domain": "string"
        },
        "right": {
          "kind": "literal",
          "value": "crm pricing"
        }
      },
      "effect_match": {
        "op": "all",
        "args": [
          {
            "op": "eq",
            "left": {
              "kind": "field",
              "path": [
                "effect",
                "after_cells",
                "keyword"
              ],
              "domain": "string"
            },
            "right": {
              "kind": "field",
              "path": [
                "request",
                "keyword"
              ],
              "domain": "string"
            }
          },
          {
            "op": "eq",
            "left": {
              "kind": "field",
              "path": [
                "effect",
                "after_cells",
                "volume"
              ],
              "domain": "string"
            },
            "right": {
              "kind": "field",
              "path": [
                "request",
                "volume"
              ],
              "domain": "string"
            }
          }
        ]
      }
    },
    {
      "check_id": "sunset-page-not-queued",
      "signal_id": "marketing.sunset_page_not_queued",
      "role": "harm",
      "operator": "effects.prohibited_when@1",
      "match_cardinality": "per_candidate",
      "population": "rows_ws_data",
      "source": "queue_adds",
      "prohibited_when": {
        "op": "eq",
        "left": {
          "kind": "field",
          "path": [
            "request",
            "keyword"
          ],
          "domain": "string"
        },
        "right": {
          "kind": "literal",
          "value": "crm benefits"
        }
      },
      "effect_match": {
        "op": "eq",
        "left": {
          "kind": "field",
          "path": [
            "effect",
            "after_cells",
            "keyword"
          ],
          "domain": "string"
        },
        "right": {
          "kind": "field",
          "path": [
            "request",
            "keyword"
          ],
          "domain": "string"
        }
      }
    }
  ]
}
