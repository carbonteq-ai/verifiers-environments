    {
      "path": [
        "task_evidence",
        "prompt",
        1,
        "content"
      ],
      "canonical_sha256": "8c3d082640d541ae79f9198d5e7b967bd78f0a5f3345dbfa9a2aecdf02374eb5"
    },
    {
