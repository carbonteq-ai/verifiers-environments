    "subscribers": {
      "adapter": "google_sheets.rows@1",
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "spreadsheet_id": "ss_subscribers",
      "worksheet_id": "ws_subs",
      "key_fields": [
        "subscriber_id"
      ],
      "required_fields": [
        "email",
        "last_confirmed_date",
        "name",
        "opted_in_date",
        "status",
        "subscriber_id"
      ]
    },
    "subscriber_updates": {
      "adapter": "google_sheets.row_writes@1",
      "kind": "update",
      "spreadsheet_id": "ss_subscribers",
      "worksheet_id": "ws_subs"
    },
    "sends": {
      "adapter": "gmail.messages@1",
      "kind": "send"
    },
    "newsletter_request": {
      "adapter": "public.request@1",
      "member_key": "newsletter-weekly-send",
      "fields": {
        "recipient": {
          "value": "newsletter@company.example.com",
          "authority_paths": [
            [
              "task_evidence",
              "prompt",
              1,
              "content"
            ]
          ]
        },
        "tracking_code": {
          "value": "NL-BATCH-2026-0127",
          "authority_paths": [
            [
              "task_evidence",
              "initial",
              "gmail",
              "messages",
