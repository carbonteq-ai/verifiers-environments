    {
      "path": [
        "task_evidence",
        "prompt"
      ],
      "canonical_sha256": "955de4a2f66383752abc016b6751595216e6bebd6b35c997155e9806d0a95fe8"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "canonical_sha256": "c30c1dbf603df56d9b0e564ebdc5db14d6cf8e5260fac5011b04791a1d92c0bc"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "gmail"
      ],
      "canonical_sha256": "b67516f5e694c54194bed494ade6d23a9d07fe05a539d2f718ab01bd5ebbc614"
    }
  ],
  "sources": {
    "invoices": {
      "adapter": "google_sheets.rows@1",
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "spreadsheet_id": "ss_ar_aging",
      "worksheet_id": "ws_outstanding_ar",
      "key_fields": [
        "Invoice #"
      ],
      "required_fields": [
        "Invoice #",
        "Customer",
        "Amount",
        "Days Overdue",
        "Billing Email",
        "Exec Sponsor",
        "Notes",
        "Last Action"
      ]
    },
    "gmail_sends": {
      "adapter": "gmail.messages@1",
      "kind": "send"
    },
    "slack_sends": {
      "adapter": "slack.messages@1",
      "kind": "channel_message"
    },
    "tracker_updates": {
      "adapter": "google_sheets.row_writes@1",
      "kind": "update",
      "spreadsheet_id": "ss_ar_aging",
      "worksheet_id": "ws_outstanding_ar"
