    }
  ],
  "sources": {
    "messages": {
      "adapter": "initial.records@1",
      "path": [
        "task_evidence",
        "initial",
        "slack",
        "messages"
      ],
      "identity_paths": [
        [
          "channel_id"
        ],
        [
          "ts"
        ]
      ],
      "fields": {
        "MessageId": [
          "id"
        ],
        "Channel": [
          "channel_id"
        ],
        "Text": [
          "text"
        ],
        "User": [
          "user_id"
        ]
      },
      "key_fields": [
        "MessageId"
      ],
      "required_fields": [
        "Channel",
        "Text",
        "User"
      ]
    },
    "logs": {
