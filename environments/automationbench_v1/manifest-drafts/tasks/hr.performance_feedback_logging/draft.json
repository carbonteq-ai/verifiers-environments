{
  "schema_version": 1,
  "manifest_id": "hr-performance_feedback_logging",
  "revision": "luna-top20-hr-20261004-v1",
  "public_request": "Our managers have been posting structured performance feedback in the #manager-feedback Slack channel. Extract each piece of feedback and log it to the Performance Log spreadsheet. Only log messages that follow the structured format. Use Slack and Google Sheets.",
  "bindings": [
    {
      "path": [
        "task_evidence",
        "initial"
      ],
      "canonical_sha256": "72274c331783bc01b6436f667ddbceb740b555ff107a897bb5e48a8ba0b97653"
    },
