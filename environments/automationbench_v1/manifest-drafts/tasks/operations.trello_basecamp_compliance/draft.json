    {
      "path": [
        "task_evidence",
        "prompt",
        1,
        "content"
      ],
      "canonical_sha256": "21155fe3d079998368f45f89f6142932b0b927be4551c93018512acc87a909d7"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "canonical_sha256": "2e951ff229745f91238c313045224c61bf576d4934f7b7596b8cadc8f9edb01d"
    },
    {
      "path": [
        "task_evidence",
        "initial",
        "trello"
      ],
      "canonical_sha256": "89de7d6c80ccb9917acd0b2753c329365088aee1d3fdc51ff2520993dfdf803a"
    }
  ],
