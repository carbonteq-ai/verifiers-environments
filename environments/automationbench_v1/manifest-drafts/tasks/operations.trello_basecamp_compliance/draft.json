        "Document"
      ],
      "required_fields": [
        "Document Type",
        "Due",
        "Priority",
        "Status"
      ]
    },
    "rules": {
      "adapter": "google_sheets.reads@1",
      "spreadsheet_id": "ss_compliance_queue",
      "worksheet_id": "ws_compliance_rules"
    },
    "card": {
      "adapter": "service.record_writes@1",
      "service": "trello",
      "collection": [
        "actions",
        "card_update"
      ],
      "kind": "create"
    },
    "label": {
      "adapter": "service.record_writes@1",
      "service": "trello",
      "collection": [
        "actions",
        "card_label"
      ],
      "kind": "create"
    },
