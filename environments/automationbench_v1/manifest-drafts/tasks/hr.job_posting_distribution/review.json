    },
    {
      "id": "R6-HRA-D3",
      "summary": "slack.messages@1 scope stays open with slack_collection_unavailable:users when the public initial Slack state declares channels/messages but no users (hr.job_posting_distribution). A missing announcement is unknown instead of 0 and the Slack alternatives of guards keep compliance unknown.",
      "smallest_fix": "hydrate an absent public users collection as empty, like other sparse public collections (mechanism 1)."
    },
    {
      "id": "R6-HRA-D4",
      "summary": "Two per_effect_negative@1 guards that fire on the same tool call abort credit planning for the whole episode (manifest_guard_assessments.plan_guard_credit raises guard_credit_aggregation_required -> credit_planning_failed:ValueError). Reproduced: one Slack post naming the Draft requisition and a paraphrased salary.",
      "smallest_fix": "aggregate same-execution harm penalties (sum or max) instead of raising; until then only one guard per overlapping channel may carry credit."
    }
  ],
