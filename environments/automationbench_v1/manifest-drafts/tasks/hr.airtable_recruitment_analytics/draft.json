                      "kind": "input",
                      "format": "usd_string",
                      "path": [
                        "request",
                        "Spend"
                      ]
                    },
                    "right": {
                      "kind": "input",
                      "format": "decimal_string",
                      "path": [
                        "request",
                        "Total Applicants"
                      ]
                    }
                  }
                },
                "mode": "amount",
                "format": "usd_string"
              }
            ],
            "excluding_values": [
