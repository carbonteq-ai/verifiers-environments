                "value": {
                  "kind": "literal",
                  "value": "$125"
                },
                "mode": "amount",
                "format": "usd_string"
              }
            ]
          },
          {
            "op": "mentions_together",
            "scope": "block",
            "text": {
              "kind": "field",
              "path": [
                "effect",
                "body_text"
              ],
              "domain": "string"
            },
            "terms": [
              {
                "value": {
                  "kind": "field",
                  "path": [
                    "request",
                    "Role"
                  ],
                  "domain": "string"
                },
                "mode": "words"
              },
              {
                "value": {
                  "kind": "field",
                  "path": [
                    "request",
                    "Days Open"
                  ],
                  "domain": "string"
                },
                "mode": "verbatim"
              },
              {
                "value": {
                  "kind": "field",
                  "path": [
                    "request",
                    "Candidates at Interview"
                  ],
                  "domain": "string"
                },
                "mode": "verbatim"
              },
              {
                "value": {
                  "kind": "field",
                  "path": [
                    "request",
                    "Total Applicants"
