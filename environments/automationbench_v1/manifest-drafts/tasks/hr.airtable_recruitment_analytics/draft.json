            "terms": [
              {
                "mode": "words",
                "value": {
                  "kind": "field",
                  "path": [
                    "request",
                    "Role"
                  ],
                  "domain": "string"
                }
              },
              {
                "mode": "verbatim",
                "value": {
                  "kind": "field",
                  "path": [
                    "request",
                    "Days Open"
                  ],
                  "domain": "string"
                }
              },
              {
                "mode": "verbatim",
                "value": {
                  "kind": "field",
                  "path": [
                    "request",
                    "Candidates at Interview"
                  ],
                  "domain": "string"
                }
              }
            ],
            "scope": "block"
          }
        ]
      },
      "match_cardinality": "per_candidate"
