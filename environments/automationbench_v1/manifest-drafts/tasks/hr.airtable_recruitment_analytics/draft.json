      "operator": "effects.required_when@1",
      "semantics": "new_occurrence",
      "population": "roles",
      "source": "sends",
      "required_when": {
        "op": "eq",
        "left": {
          "kind": "literal",
          "value": true
        },
        "right": {
          "kind": "literal",
          "value": true
        }
      },
      "effect_match": {
        "op": "all",
        "args": [
          {
            "op": "in",
            "left": {
              "kind": "field",
              "path": [
                "request",
                "Manager Email"
              ],
              "domain": "string"
            },
            "right": {
              "kind": "field",
              "path": [
                "effect",
                "recipients"
              ],
              "domain": "sequence"
            }
          },
          {
            "op": "mentions_together",
            "scope": "text",
            "text": {
              "kind": "field",
              "path": [
                "effect",
                "body_text"
              ],
              "domain": "string"
            },
            "terms": [
              {
                "value": {
                  "kind": "field",
                  "path": [
                    "request",
                    "Role"
                  ],
                  "domain": "string"
                },
                "mode": "words"
              },
              {
                "value": {
                  "kind": "derived",
