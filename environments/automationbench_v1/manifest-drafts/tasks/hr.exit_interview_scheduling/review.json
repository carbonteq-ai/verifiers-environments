 "mechanism_defects": [
  {
   "id": "R3-D4_two_digit_hour_without_meridiem_read_as_24h",
   "mechanism": "mentions mode clock_time / value format clock_time (mechanisms 6-7)",
   "code": "src/automationbench_v1/contracts/predicates.py:523 (_CLOCK_24_TEXT accepts 10:00-12:59 without a meridiem) vs :524 (_CLOCK_BARE_TEXT marks only one-digit hours ambiguous); values.py:89 (_CLOCK_24 fullmatch)",
   "reproducer": "/tmp/claude-1000/-home-hammad-projects-rl/06f4fe1b-c6e2-45ea-9bb2-d0b2a04f9815/scratchpad/round-3/hr/defects_repro.py (output defects_repro.out.json)",
   "observed": {
    "'Break 10:00-10:30 PM' mentions 10:00 AM": true,
    "'Break 10:00-10:30 PM' mentions 10:00 PM": false,
    "'Break 12:00-12:30 AM' mentions 12:00 PM": true,
    "value clock_time '10:00'": "600 (10 AM)"
   },
   "effect": "Known-wrong answers: a range whose meridiem follows the second time ('10:00-10:30 PM', a common spelling) is read as 10:00 AM, so a correct DM is a known 0 and a wrong one can pass. Meridiem-less 10:00-12:59 is as ambiguous as 1:00-9:59 in English prose but is treated as 24h.",
   "smallest_fix": "Treat a meridiem-less HH:MM whose hour is 1-12 as ambiguous (24h only for 00-09 with a leading zero or 13-23), or, in a range 'a-b <meridiem>', apply b's meridiem candidates to a and stay unknown when they disagree.",
   "affects_luna": "No change on the break episode: Alice's '12:00-12:30 PM' reads 12:00 as 720 = 12:00 PM by coincidence."
  },
  {
   "id": "R3-D5_noon_midnight_known_false",
   "mechanism": "mentions mode clock_time / value format clock_time",
   "code": "predicates.py:595-602 (_term_in_line returns False when no clock pattern and no bare one-digit time); values.py:96-111",
   "observed": {
    "'Break confirmed at noon' mentions 12:00 PM": false,
    "value clock_time 'noon'": "unavailable"
   },
   "effect": "A correct 'at noon' confirmation is a known 0 (the value form is correctly unknown, the mention form is not).",
   "smallest_fix": "Read 'noon'/'midday' as 720 and 'midnight' as 0 in both parsers; at minimum return unknown when such a word is present.",
   "workaround_in_draft": "hr.break_schedule_processing v3 accepts the word 'noon' beside clock_time only when the authored request literal is exactly 12:00 PM."
  }
 ],
 "mechanism_limitations": [
  {
   "id": "R3-L1_join_timing_cannot_look_forward",
   "mechanism": "effect_joins (mechanism 8)",
   "code": "obligations.py:81 timing Literal['before','not_after']; obligations.py:290",
   "evidence": "break alternative correct_but_dms_before_sheet: the joined-value DM checks (adjusted duration, moved time) abstain because the sheet write comes after the DM; any-channel delivery (buddy Gmail-or-Slack, exit calendar-or-email invite) cannot be written as 'primary OR join' without a known 0 when the other channel is later.",
   "smallest_mechanism": "timing 'any' (whole episode, complete inventory required) or obligation 'sources' any-of."
  },
  {
   "id": "R3-L2_either_format_duration",
   "mechanism": "value formats duration_text vs decimal_string (mechanism 6)",
   "evidence": "any(gte(duration_text(c),30), gte(decimal_string(c),30)) is null for both '15' and '15 minutes' (one branch is always unavailable), so it can never be a known 0 (defects_repro.out.json L2).",
   "workaround_in_draft": "break v3 chooses the parse by whether the cell carries a unit word (minutes/min/hour/hr...), which is format discrimination over an exact amount, not wording.",
