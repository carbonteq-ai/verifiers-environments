   },
   "gap_category": "other:business_day_arithmetic",
   "why_not_expressible": "ValueExpression has days_between/within_interval/add_calendar_months only (values.py:195-198); there is no weekday or business-day offset, and the system prompt defers business-day calendars to task procedures. Saturday last days (Karen 04-25, Nathan 05-02) also admit two readings (04-20 vs 04-17). The date lives in the invite, which is itself the multi-source gap.",
   "mechanism_sketch": "value op business_days_before(date, n, weekend=[sat,sun], holidays=[]) returning a calendar_date, with an explicit convention for weekend reference days (or any_ over both readings); compare with iso_timestamp(event start, UTC) or a date in the email.",
   "reused_by": [
