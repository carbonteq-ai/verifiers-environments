  "obligations": [
    {
      "id": "P1",
      "kind": "selection",
      "status": "gap",
      "check_id": null,
      "public_anchor": {
        "text": "We need to publish the current approved visitor policy and loop in Security.\n\nCheck the policy updates sheet (ss_policy) for the active approved visitor policy. The sheet also has processing rules so review those before selecting anything.\n\nCreate a Confluence page in SP_OPS (cloud_ops) titled 'Visitor Policy Update - 2026' with the effective date and changes.\n\nEmail security@company.example.com to let them know about the update (subject: 'Visitor Policy Updated').\n\nToday is 2026-01-31. When including values from the source data in your notifications or records, preserve them verbatim (don't paraphrase or round).\n\nPublic source rows (exact cells and row IDs): [{\"cells\":{\"Effective\":\"2026-02-15\",\"Last Updated\":\"2026-01-28\",\"Notes\":\"\",\"Policy\":\"Visitor Policy\",\"Status\":\"Approved\",\"Summary\":\"Pre-register all visitors\"},\"row_id\":2},{\"cells\":{\"Effective\":\"2026-03-01\",\"Last Updated\":\"2026-01-30\",\"Notes\":\"\",\"Policy\":\"Visitor Policy\",\"Status\":\"Draft\",\"Summary\":\"Escort required\"},\"row_id\":3},{\"cells\":{\"Effective\":\"2026-02-10\",\"Last Updated\":\"2026-01-29\",\"Notes\":\"\",\"Policy\":\"Parking Policy\",\"Status\":\"Approved\",\"Summary\":\"Reserved spots for visitors\"},\"row_id\":4},{\"cells\":{\"Effective\":\"2026-01-15\",\"Last Updated\":\"2026-01-25\",\"Notes\":\"\",\"Policy\":\"Visitor Badge Policy\",\"Status\":\"Revoked\",\"Summary\":\"Temporary badges for all visitors\"},\"row_id\":5},{\"cells\":{\"Effective\":\"2026-03-15\",\"Last Updated\":\"2026-01-31\",\"Notes\":\"\",\"Policy\":\"Building Access Policy\",\"Status\":\"Under Review\",\"Summary\":\"Visitor access restricted after hours\"},\"row_id\":6},{\"cells\":{\"Effective\":\"2026-02-20\",\"Last Updated\":\"2026-01-31\",\"Notes\":\"superseded - compliance review VPOL-2026-002 determined the original approved version takes precedence\",\"Policy\":\"Visitor Policy\",\"Status\":\"Approved\",\"Summary\":\"Extend visitor pre-registration window to 48 hours\"},\"row_id\":7}]",
        "path": "prompt[1].content; initial_state.google_sheets rows in ss_policy/ws_updates"
      },
      "note": "Select currently active approved visitor policy; policy candidates include superseded approved row and status/notes must be reconciled."
    },
    {
      "id": "P2",
      "kind": "constraint",
      "status": "expressed",
      "check_id": "supersession-hold-policy-row-read",
      "public_anchor": {
        "text": "We need to publish the current approved visitor policy and loop in Security.\n\nCheck the policy updates sheet (ss_policy) for the active approved visitor policy. The sheet also has processing rules so review those before selecting anything.\n\nCreate a Confluence page in SP_OPS (cloud_ops) titled 'Visitor Policy Update - 2026' with the effective date and changes.\n\nEmail security@company.example.com to let them know about the update (subject: 'Visitor Policy Updated').\n\nToday is 2026-01-31. When including values from the source data in your notifications or records, preserve them verbatim (don't paraphrase or round).\n\nPublic source rows (exact cells and row IDs): [{\"cells\":{\"Description\":\"Policy rows with 'superseded' in Notes have been overridden by an official compliance review. Do not publish superseded rows even if they carry Approved status.\",\"Rule\":\"Supersession Hold\"},\"row_id\":2}]",
        "path": "prompt[1].content; initial_state.google_sheets rows in ss_policy/ws_policy"
      },
      "note": "Review processing rules before selecting; policy read relation is not source-qualified."
    },
