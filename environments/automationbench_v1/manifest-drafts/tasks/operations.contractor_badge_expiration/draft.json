    "badges": {
      "adapter": "google_sheets.rows@1",
      "spreadsheet_id": "ss_badges",
      "worksheet_id": "ws_contractors",
      "path": [
        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "key_fields": [
        "Badge Number",
        "Contractor"
      ],
      "required_fields": [
        "Badge Number",
        "Contractor",
        "Company Contact",
        "Expiry",
        "Phone",
        "Status",
        "Notes"
      ]
    },
