 "obligations": [
  {
   "id": "feedback-scope",
   "kind": "constraint",
   "status": "expressed",
   "check_id": "required_when of feedback-chatgpt-sentiment and feedback-marked-read",
   "public_anchor": {
    "quote": "Look for unread emails with 'Feedback' in the subject from the last 24 hours (since 2026-01-29). Skip any that are already labeled 'PROCESSED' or from internal @company.example.com addresses.",
    "path": [
     "prompt",
     1,
     "content"
    ]
   },
   "how": "is_read false, subject word 'Feedback', UTC date >= 2026-01-29, no PROCESSED label, sender not company.example.com (10 of 43 messages)."
  },
  {
   "id": "chatgpt-sentiment-each",
   "kind": "goal",
   "status": "expressed",
   "check_id": "feedback-chatgpt-sentiment",
   "public_anchor": {
    "quote": "Use ChatGPT to analyze the sentiment of each one - positive, negative, or neutral.",
    "path": [
     "prompt",
     1,
     "content"
    ]
   },
   "how": "A chatgpt.completions record whose values_text contains the feedback body verbatim (per_candidate, so one batched prompt counts). The sentiment it returns is not judged."
  },
  {
   "id": "negative-to-customer-issues",
   "kind": "goal",
   "status": "out_of_scope",
   "reason": "requires_judgement",
   "public_anchor": {
    "quote": "Channels '#customer-issues', Domain Type 'Standard', Sentiment 'Negative'",
    "path": [
     "initial_state",
     "google_sheets",
     "rows",
     1,
     "cells"
    ]
   },
   "note": "Which emails are negative is a sentiment judgement; the simulated ChatGPT returns a constant."
  },
  {
   "id": "vip-escalation-enterprise-corp-group",
   "kind": "goal",
   "status": "out_of_scope",
   "reason": "requires_judgement",
   "public_anchor": {
    "quote": "domains containing 'group' now also qualify for VIP escalation routing",
    "path": [
     "initial_state",
     "google_sheets",
     "rows",
     5,
     "cells",
     "Policy"
    ]
   },
   "note": "Depends on negative sentiment. Its deterministic domain half would also need a substring test: mentions matches whole tokens only (predicates.py:477, verbatim boundaries at 578-581), so 'corp' in 'bigcorp' is false. Smallest mechanism: mentions mode 'substring' (other:substring_match)."
  },
  {
   "id": "positive-to-customer-wins-with-email",
   "kind": "goal",
   "status": "out_of_scope",
   "reason": "requires_judgement",
   "public_anchor": {
    "quote": "Channels '#customer-wins', Sentiment 'Positive', Notes 'Include customer email and summary'",
    "path": [
     "initial_state",
     "google_sheets",
     "rows",
     2,
     "cells"
    ]
   },
   "note": "Which emails are positive is a judgement; the deterministic 'include customer email' part is listed separately under verbatim-source-values."
  },
  {
   "id": "wins-post-summary",
   "kind": "report",
   "status": "out_of_scope",
   "reason": "requires_judgement",
   "public_anchor": {
    "quote": "Include customer email and summary",
    "path": [
     "initial_state",
     "google_sheets",
     "rows",
     2,
     "cells",
     "Notes"
    ]
   }
  },
  {
   "id": "neutral-not-posted",
   "kind": "guard",
   "status": "out_of_scope",
   "reason": "requires_judgement",
   "public_anchor": {
    "quote": "Do not post neutral feedback to any channel",
    "path": [
     "initial_state",
     "google_sheets",
     "rows",
     3,
     "cells",
     "Notes"
    ]
   }
  },
  {
   "id": "no-misrouting",
   "kind": "guard",
   "status": "out_of_scope",
   "reason": "requires_judgement",
   "public_anchor": {
    "quote": "Channels '#customer-issues' for Negative/'Standard' ('All other domains')",
    "path": [
     "initial_state",
     "google_sheets",
     "rows",
     1,
     "cells"
    ]
   },
   "note": "Correct channel depends on sentiment."
  },
  {
   "id": "self-resolved-not-posted",
   "kind": "guard",
   "status": "expressed",
   "public_anchor": {
    "quote": "If a feedback email body contains resolution language such as 'resolved', 'fixed', 'no action needed', or 'issue has been addressed', treat as informational only. Do NOT route to any Slack channel",
    "path": [
     "initial_state",
     "google_sheets",
     "rows",
     4,
     "cells",
     "Policy"
    ]
   },
   "note": "Only the listed phrases are deterministic; the open-ended 'such as' remainder needs judgement. On the bound data only fb_010 qualifies.",
   "reused_by": [
    "operations.trello_vendor_hold_email"
   ],
   "check_id": "self-resolved-feedback-posted",
   "how": "Guard over the Gmail population: in-scope email whose body contains one of the listed phrases ('resolved', 'fixed', 'no action needed', 'issue has been addressed', words) and a channel post naming it (same identification and unknown band as the seasonal guard)."
  },
  {
   "id": "seasonal-hold-not-posted",
   "kind": "guard",
   "status": "expressed",
   "check_id": "seasonal-feedback-posted",
   "public_anchor": {
    "quote": "must be placed on hold for account manager review. Do NOT route to any Slack channel. Mark as read but do not post.",
    "path": [
     "initial_state",
     "google_sheets",
     "rows",
     6,
     "cells",
     "Policy"
    ]
   },
   "how": "Round 4: guard over the bound Gmail population (initial.records@1) instead of the override table. Held = in scope and the body has a seasonal keyword (winter/summer/seasonal/resort as words). A channel post naming the email (sender verbatim, subject words or body verbatim) fires; a post naming only other feedback emails does not; a post naming none is unknown. The domain-substring half of the rule is not expressible (mentions matches whole tokens) but is redundant on the bound data: fb_011's body also says 'winter'."
  },
  {
   "id": "mark-processed-read",
   "kind": "goal",
   "status": "expressed",
   "check_id": "feedback-marked-read",
   "public_anchor": {
    "quote": "Mark all the processed emails as read when done.",
    "path": [
     "prompt",
     1,
     "content"
    ]
   },
   "how": "gmail.messages update to is_read true for each in-scope message (held and self-resolved ones included)."
  },
  {
   "id": "skipped-emails-untouched",
   "kind": "guard",
   "status": "expressed",
   "public_anchor": {
    "quote": "Skip any that are already labeled 'PROCESSED' or from internal @company.example.com addresses.",
    "path": [
