   ],
   "check_id": "skipped-feedback-posted + skipped-feedback-marked-read + skipped-feedback-analyzed",
   "how": "Three guards over the Gmail population for Feedback-subject emails that are out of scope (PROCESSED label, internal sender, or dated before 2026-01-29): a channel post naming one, an is_read update on one, or a ChatGPT completion containing its body verbatim.",
   "interpretation": "'Skip' means not processing at all: no analysis, no routing, no read-marking. The old fb_007 is included because the prompt restricts processing to emails since 2026-01-29."
  },
  {
   "id": "verbatim-source-values",
