        "task_evidence",
        "initial",
        "google_sheets"
      ],
      "spreadsheet_id": "ss_mentions",
      "worksheet_id": "ws_social",
      "key_fields": [
        "url"
      ],
      "required_fields": [
        "author",
        "platform"
